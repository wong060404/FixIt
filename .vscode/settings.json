{
  "cmake.sourceDirectory": "${workspaceFolder}",
  "cmake.buildDirectory": "${workspaceFolder}/build",
  "cmake.configureOnOpen": false,
  "cmake.configureArgs": ["-DCMAKE_BUILD_TYPE=Debug"],

  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json",
  "C_Cpp.default.cppStandard": "c++20",
  "C_Cpp.formatting": "clangFormat",
  "C_Cpp.clang_format_fallbackStyle": "{ BasedOnStyle: Google, IndentWidth: 4, ColumnLimit: 100 }",
  "[cpp]": { "editor.defaultFormatter": "ms-vscode.cpptools", "editor.formatOnSave": true },
  "[c]":   { "editor.defaultFormatter": "ms-vscode.cpptools", "editor.formatOnSave": true },
  "files.associations": { "*.hpp": "cpp", "*.h": "cpp", "CMakeLists.txt": "cmake" },
  "search.exclude": { "build/**": true, "build-win/**": true },
  "files.watcherExclude": { "**/build/**": true, "**/build-win/**": true }
}
