{
  // fixit 是 CMake 專案 → 一律用 CMake 建置，再用 lldb 除錯 build/bin/ 內的執行檔
  // 注意：不要用「C/C++: 建置使用中檔案」除錯，src/ 與 tests/ 無法單檔編譯
  "version": "0.2.0",
  "configurations": [
    {
      "name": "fixit CLI：對目前檔案跑 --outline（mock LLM）",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/fixit",
      "args": ["${file}", "--outline"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "lldb",
      "preLaunchTask": "cmake: build",
      "setupCommands": [
        {
          "description": "開啟 lldb 美化列印",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "fixit CLI：對目前檔案跑修復流程（--agent --no-write）",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/fixit",
      "args": ["${file}", "--agent", "--no-write"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "lldb",
      "preLaunchTask": "cmake: build",
