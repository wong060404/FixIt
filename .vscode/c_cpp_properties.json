{
  // 用 CMake 產生的編譯資料庫餵給 IntelliSense，這樣 catch2 / tree-sitter 的標頭都找得到。
  // compilerPath 與 intelliSenseMode 交給 compile_commands.json / CMake 決定，
  // 不再硬寫某台機器 / 某個作業系統的路徑。
  "configurations": [
    {
      "name": "fixit-cmake",
      "compileCommands": "${workspaceFolder}/build/compile_commands.json",
      "includePath": [
        "${workspaceFolder}/include",
        "${workspaceFolder}/third_party/Catch2/src/catch2",
        "${workspaceFolder}/third_party/**"
      ],
      "cStandard": "c17",
      "cppStandard": "c++20",
      "intelliSenseMode": "${default}"
    }
  ],
  "version": 4
}
