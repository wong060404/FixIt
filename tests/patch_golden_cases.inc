    const std::string content = "#include <cstdio>\n#include <string>\n\nnamespace demo {\n\nint helper_a(int value) {\n  int total_a = value;\n  return total_a;\n}\n\nint helper_b(int value) {\n  int total_b = value * 3;\n  return total_b + 1;\n}\n\nstd::string name_of(int id) {\n  if (id == 1) return \"one\";\n  if (id == 2) return \"two\";\n  return \"many\";\n}\n\nint run(int id) {\n  const int value = id * 2;\n  return helper_a(value) + helper_b(value);\n}\n\n}  // namespace demo\n";
